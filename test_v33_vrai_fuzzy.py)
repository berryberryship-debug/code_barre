import numpy as np
from scipy.ndimage import gaussian_filter
import reedsolo # <-- La vraie librairie de correction d'erreur

def generer_masque_phase(N=128):
    phase = np.random.uniform(0, 2*np.pi, (N, N))
    return np.exp(1j * phase)

def simuler_lecture_laser(masque, bruit_camera=0.01):
    champ = np.fft.fftshift(np.fft.fft2(masque))
    intensite = np.abs(champ)**2
    intensite = intensite / np.max(intensite)
    intensite_bruitee = intensite + np.random.normal(0, bruit_camera, intensite.shape)
    return np.clip(intensite_bruitee, 0, 1)

def extraire_cle_robuste(intensite, block_size=8):
    intensite_floue = gaussian_filter(intensite, sigma=2.0)
    N = intensite.shape[0]
    n_blocks = N // block_size
    blocs = intensite_floue.reshape(n_blocks, block_size, n_blocks, block_size)
    moyennes = blocs.mean(axis=(1, 3))
    bits = (moyennes[:, :-1] > moyennes[:, 1:]).astype(int)
    return bits.flatten()

def distance_hamming(cle1, cle2):
    n = min(len(cle1), len(cle2))
    return np.mean(cle1[:n] != cle2[:n]) * 100

def main():
    print("=== V33: PUF OPTIQUE AVEC VRAI FUZZY EXTRACTOR (REED-SOLOMON) ===")
    
    N = 128
    np.random.seed(42)
    masque_A = generer_masque_phase(N)
    
    # --- 1. Enrôlement (Fabrication) ---
    # On génère une clé secrète aléatoire de 128 bits (celle qu'on veut protéger)
    cle_secrete = np.random.randint(0, 2, 128)
    
    # On lit la PUF dans des conditions parfaites
    intensite_ref = simuler_lecture_laser(masque_A, bruit_camera=0.0)
    bits_puf_ref = extraire_cle_robuste(intensite_ref)
    
    # On crée la "Helper Data" (Données d'aide) : c'est le XOR entre la PUF et la clé secrète
    # On ne garde que les 128 premiers bits pour faire simple
    helper_data = bits_puf_ref[:128] ^ cle_secrete
    
    # On encode la Helper Data avec Reed-Solomon pour pouvoir la corriger plus tard
    rs = reedsolo.RSCodec(20) # On ajoute 20 octets de correction
    helper_encodee = rs.encode(bytearray(helper_data))
    
    print(f"Clé secrète : {len(cle_secrete)} bits")
    print(f"PUF brute lue : {len(bits_puf_ref)} bits")
    
    # --- 2. Authentification (Sous bruit) ---
    print("\n--- Test de lecture sous bruit ---")
    bruits = [0.01, 0.05, 0.10]
    
    for b in bruits:
        intensite_bruitee = simuler_lecture_laser(masque_A, bruit_camera=b)
        bits_puf_bruite = extraire_cle_robuste(intensite_bruitee)
        
        # 1. Erreur de la PUF brute
        err_brute = distance_hamming(bits_puf_ref, bits_puf_bruite)
        
        # 2. L'algorithme essaie de retrouver la clé secrète
        try:
            # On décode la Helper Data (Reed-Solomon corrige les erreurs)
            helper_corrigee_bytes, _, _ = rs.decode(helper_encodee)
            helper_corrigee = np.unpackbits(np.frombuffer(bytes(helper_corrigee_bytes), dtype=np.uint8))[:128]
            
            # On fait le XOR entre la nouvelle lecture PUF et la Helper Data
            cle_retrouvee = bits_puf_bruite[:128] ^ helper_corrigee
            
            # 3. On compare avec la vraie clé secrète
            err_finale = distance_hamming(cle_secrete, cle_retrouvee)
            print(f"Bruit = {b:.2f} | PUF Brute = {err_brute:5.2f}% | Clé Récupérée = {err_finale:5.2f}%")
            
        except reedsolo.ReedSolomonError:
            print(f"Bruit = {b:.2f} | PUF Brute = {err_brute:5.2f}% | ECHEC : Trop d'erreurs, impossible de corriger.")

if __name__ == "__main__":
    main()
